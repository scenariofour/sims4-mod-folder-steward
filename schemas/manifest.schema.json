{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s4mod:schema:manifest:1.0",
  "title": "Sims 4 Mod Folder Steward applied-run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "workspace_root",
    "status",
    "before_snapshot",
    "after_snapshot",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace_root": { "const": "<SIMS4_WORKSPACE>" },
    "status": { "enum": ["applying", "applied", "rolled_back", "rollback_failed"] },
    "before_snapshot": { "type": "string", "const": "before.json" },
    "after_snapshot": {
      "oneOf": [
        { "type": "string", "const": "after.json" },
        { "type": "null" }
      ]
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/appliedOperation" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\\\\\/])\\.\\.(?:[\\\\\\\\/]|$)).+$"
    },
    "appliedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "action", "source", "destination", "status", "source_sha256", "target_before_sha256", "quarantine_path", "error"],
      "properties": {
        "operation_id": { "type": "string", "format": "uuid" },
        "action": { "enum": ["install", "replace", "backup"] },
        "source": { "$ref": "#/$defs/relativePath" },
        "destination": { "$ref": "#/$defs/relativePath" },
        "status": { "enum": ["pending", "completed", "skipped", "rolled_back", "failed"] },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "target_before_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "quarantine_path": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
